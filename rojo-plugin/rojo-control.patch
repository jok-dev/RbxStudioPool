@@ -63,8 +63,18 @@ ServeSession.Status = Status
 local validateServeOptions = t.strictInterface({
 	apiContext = t.table,
 	twoWaySync = t.boolean,
+	-- RojoControl fork: start without applying anything; changes count as pending until syncOnce or setLive(true)
+	startPaused = t.optional(t.boolean),
 })
 
+local function patchSize(patch)
+	local size = #patch.removed + #patch.updated
+	for _ in patch.added do
+		size += 1
+	end
+	return size
+end
+
 function ServeSession.new(options)
 	assert(validateServeOptions(options))
 
@@ -109,6 +119,10 @@ function ServeSession.new(options)
 		__precommitCallbacks = {},
 		__postcommitCallbacks = {},
 		__updateLoadingText = function() end,
+		__live = not options.startPaused,
+		__pending = 0,
+		__lastSync = nil,
+		__rootId = nil,
 	}
 
 	setmetatable(self, ServeSession)
@@ -135,6 +149,39 @@ function ServeSession:onStatusChanged(callback)
 	self.__statusChangedCallback = callback
 end
 
+-- RojoControl fork: live/paused state, pending change count, sync once.
+function ServeSession:getSyncState()
+	return { live = self.__live, pending = self.__pending, lastSync = self.__lastSync }
+end
+
+function ServeSession:setLive(live: boolean)
+	self.__live = live
+	if live and self.__pending > 0 then
+		return self:syncOnce()
+	end
+	return Promise.resolve()
+end
+
+-- Re-reads the whole tree and applies the difference, like the initial sync without the confirmation step.
+-- More robust than replaying queued messages, since Studio may have changed in between.
+function ServeSession:syncOnce()
+	if self.__status ~= Status.Connected then
+		return Promise.reject("Not connected")
+	end
+
+	return self.__apiContext:read({ self.__rootId }):andThen(function(readResponseBody)
+		self.__apiContext:setMessageCursor(readResponseBody.messageCursor)
+		self.__reconciler:hydrate(readResponseBody.instances, self.__rootId, game)
+		local success, patch = self.__reconciler:diff(readResponseBody.instances, self.__rootId, game)
+		if not success then
+			return Promise.reject(patch)
+		end
+		self:__applyPatch(patch)
+		self.__pending = 0
+		self.__lastSync = os.time()
+	end)
+end
+
 function ServeSession:setConfirmCallback(callback)
 	self.__userConfirmCallback = callback
 end
